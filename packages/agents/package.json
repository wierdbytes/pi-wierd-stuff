{
  "name": "@wierdbytes/pi-agents",
  "version": "0.1.1",
  "description": "Sub-agents for pi that run as their own pi in herdr-core terminals, nested under the agent that started them in herdr. Agent / get_subagent_result / steer_subagent / stop_subagent tools plus a pi.events RPC.",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "subagents",
    "herdr",
    "herdr-core"
  ],
  "license": "MIT",
  "author": "wierdbytes",
  "homepage": "https://github.com/wierdbytes/pi-wierd-stuff/tree/master/packages/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wierdbytes/pi-wierd-stuff.git",
    "directory": "packages/agents"
  },
  "bugs": {
    "url": "https://github.com/wierdbytes/pi-wierd-stuff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./client.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wierdbytes/pi-common": "^0.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "^1.1.24",
    "vitest": "^4.0.18"
  }
}
