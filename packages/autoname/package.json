{
  "name": "@wierdbytes/pi-autoname",
  "version": "0.1.1",
  "description": "Auto-name pi sessions and the terminal title with a short summary from a cheap model — so herdr, tmux and terminal tabs show what each pi is doing.",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "session-name",
    "terminal-title",
    "herdr"
  ],
  "license": "MIT",
  "author": "wierdbytes",
  "homepage": "https://github.com/wierdbytes/pi-wierd-stuff/tree/master/packages/autoname",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wierdbytes/pi-wierd-stuff.git",
    "directory": "packages/autoname"
  },
  "bugs": {
    "url": "https://github.com/wierdbytes/pi-wierd-stuff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wierdbytes/pi-common": "^0.5.0",
    "@wierdbytes/pi-events": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "vitest": "^4.0.18"
  }
}
