{
  "name": "@wierdbytes/pi-dream",
  "version": "0.1.1",
  "description": "Offline memory consolidation (\"dreaming\") for pi: distills past sessions into small, evidence-backed memory notes, sends every change to a GitHub pull request for review, injects the approved index into new sessions and adds memory search / read / inbox tools.",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "memory",
    "dreaming",
    "agent-memory"
  ],
  "license": "MIT",
  "author": "wierdbytes",
  "homepage": "https://github.com/wierdbytes/pi-wierd-stuff/tree/master/packages/dream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wierdbytes/pi-wierd-stuff.git",
    "directory": "packages/dream"
  },
  "bugs": {
    "url": "https://github.com/wierdbytes/pi-wierd-stuff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "^1.1.24",
    "vitest": "^4.0.18"
  }
}
